# Скопируйте в /etc/alice/env и заполните. После изменений: systemctl restart alice

# Обязательно: ключ Gemini (Google AI Studio или Google Cloud Console)
GEMINI_API_KEY=

# Необязательно: ключ Serper для поиска в интернете (погода, курсы, новости)
SERPER_API_KEY=

# Основная модель и запасная. Запасная запрашивается параллельно и выручает,
# если основная не успела ответить за отведённое время.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# 0 = без «рассуждения», иначе модель не укладывается в лимит Алисы
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_OUTPUT_TOKENS=400

# skill_id навыка из Яндекс Диалогов (виден в адресе страницы навыка).
# Если задан, запросы от чужих навыков получают 403.
ALICE_SKILL_ID=

PORT=8090
